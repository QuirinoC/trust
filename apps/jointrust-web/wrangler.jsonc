{
  "name": "jointrust-web",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "jointrust.app", "custom_domain": true },
    { "pattern": "www.jointrust.app", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      // Invite codes are path segments in /i/<code>; invocation logs include request URLs.
      // Keep custom and error logs enabled while preventing persisted invocation URLs.
      "invocation_logs": false
    }
  },
  "env": {
    "staging": {
      "name": "jointrust-web-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "staging.jointrust.app", "custom_domain": true }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_HOST": "staging.jointrust.app",
        "APP_ID": "3S529795M9.com.collapsetechnologies.trust.staging",
        "APP_SCHEME": "trust-staging",
        "APP_LABEL": "Trust Staging"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "invocation_logs": false
        }
      }
    }
  }
}
